# Local development defaults. Never commit real secrets.
PRACTICE_XIAODA_ENV=development
HOST=127.0.0.1
PORT=8765
PRACTICE_XIAODA_DB=data/practice_xiaoda.db
SEED_DEMO_DATA=true

# Needed only for the public Caddy deployment override. Use a domain name,
# without https://, after its DNS A/AAAA record points at the server.
DOMAIN=agent.example.com

# The OpenAI-compatible endpoint accepts this Bearer token.
# In development, the fallback token is dev-local-key; set a real value before sharing.
XIAODA_API_KEY=replace-with-a-long-random-secret
XIAODA_MODEL_ID=practice-xiaoda
RATE_LIMIT_PER_MINUTE=60

# Required for production management API writes. Keep the dashboard disabled in production
# unless an authenticated admin gateway protects it.
ADMIN_API_KEY=replace-with-a-separate-admin-secret
PUBLIC_DASHBOARD=false

# 数据库为空时是否自动载入演示项目。换成真实项目库后设为 false，
# 否则删空演示数据再重启，它们会被重新灌回来。
SEED_DEMO_DATA=true

# 可选的写作模型。只用于"写"（目前是公众号推送文案），不参与任何事实判断：
# 项目推荐、报名截止、资格、报销一律走规则 + SQLite，保证零幻觉、可回查原文。
# 不配也能用，写作类请求会自动降级成要点清单，不会报错。
# DeepSeek 兼容 OpenAI 协议，换其它厂商改 LLM_BASE_URL 和 LLM_MODEL 即可。
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=45

# 可选：健康自检失败时推送到微信（Server 酱的 SendKey）。留空则只写日志。
HEALTH_ALERT_SCKEY=

# Optional upstream WeChat collector. Credentials must stay in the deployment secret store.
WECHAT_COLLECTOR_PATH=
WECHAT_COLLECTOR_PYTHON=
WECHAT_TOKEN=
WECHAT_COOKIE=
WECHAT_DAILY_COUNT=12

# Recommended collector: WeWe RSS discovers public articles through a
# separately authorized WeChat Reading account. Its token stays in WeWe's own
# data volume and is sent to the configured relay only with explicit consent.
# WECHAT_COLLECTOR_PATH=scripts/wewe_collector.py
# WEWE_BASE_URL=http://127.0.0.1:4000
# WECHAT_COLLECTOR_PYTHON=python3
# Legacy diagnostic collector (not the default because the MP history list
# returns ret=200013 in current testing):
WERSS_DB_PATH=data/werss/we_mp_rss.db
WERSS_ADMIN_USERNAME=admin
WERSS_ADMIN_PASSWORD=replace-with-a-long-random-secret
WEWE_AUTH_CODE=replace-with-a-long-random-secret
WEWE_BASE_URL=http://127.0.0.1:4000
# Pin this to a verified tag or digest in production after the first pull.
WEWE_IMAGE=cooderl/wewe-rss-sqlite:latest
WECHAT_DAILY_TIME=08:25
WECHAT_RUN_ON_START=false

# Optional: enables the “查询实时交通” button in the action workspace.
# Create a Web 服务 key in 高德地图开放平台; keep it only in deployment secrets.
# Without it, the UI keeps a manual-map fallback and never fabricates routes.
AMAP_WEB_SERVICE_KEY=
